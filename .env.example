# Copy to .env for local dev. On Vercel, add the same names under Project → Settings → Environment Variables, then redeploy.

VITE_SUPABASE_URL=https://dhuswldjuuhtxejnmfla.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional — if omitted, derived from VITE_SUPABASE_URL + /functions/v1/ai-proxy
# VITE_AI_PROXY_URL=https://dhuswldjuuhtxejnmfla.supabase.co/functions/v1/ai-proxy
# Anthropic key lives in Supabase secrets as ANTHROPIC_API_KEY (not in VITE_*).

# Do NOT put your Anthropic API key in VITE_* variables — it would be exposed in the browser bundle.
